{
    "name": "Argus SQL",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "customizations": {
      "vscode": {
        "extensions": [
          "ms-python.python",
          "charliermarsh.ruff",
          "googlecloudtools.cloudcode",
          "hashicorp.terraform",
          "ms-azuretools.vscode-docker"
        ]
      }
    },
    "postCreateCommand": "git config --global --add safe.directory /workspaces/argus_sql && uv sync && uv run pre-commit install"
}